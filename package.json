{
  "name": "arogyabhog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ArogyaBhog — D2C flour (atta) e-commerce with a custom-blend Lab",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "graph": "bash scripts/history-graph.sh"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "20.17.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "fast-check": "3.23.2",
    "playwright-core": "^1.49.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  }
}
